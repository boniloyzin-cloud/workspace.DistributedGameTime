})

createFeatureControl(MovementTab, "RevivedAura", "Revive Aura")
createFeatureControl(MovementTab, "AutoTrimp", "Auto Trimp")
createFeatureControl(MovementTab, "Noclip", "Noclip")
createFeatureControl(MovementTab, "InfJump", "Infinite Jump")

-- MAIN TAB CONTROLS

MainTab:CreateToggle({
   Name = "Show Game Time",
   CurrentValue = false,
   Flag = "ShowGameTimeToggle",
   Callback = function(Value)
      getgenv().ShowGameTime = Value
      notifyStatus("Show Game Time", Value)
      if Value then
          startTime = workspace.DistributedGameTime
          if not timerParagraph then
              timerParagraph = MainTab:CreateParagraph({ Title = "In-Game Time", Content = "Elapsed Time: 00:00" })
          end
      else
          if timerParagraph then
              timerParagraph:Set({ Title = "In-Game Time", Content = "Timer Stopped" })
          end
      end
   end,
})

MainTab:CreateToggle({
   Name = "Auto Win (Fly High & Safe Platform)",
   CurrentValue = false,
   Flag = "AutoWinToggle",
   Callback = function(Value)
      getgenv().AutoWin = Value
      notifyStatus("Auto Win", Value)
      pcall(function()
          local char = LocalPlayer.Character
          local hrp = char and char:FindFirstChild("HumanoidRootPart")
          if Value and hrp then
              hrp.CFrame = hrp.CFrame + Vector3.new(0, 500, 0)
              
              if not winPlatform or not winPlatform.Parent then
                  winPlatform = Instance.new("Part")
                  winPlatform.Name = "DAVI_SafeBoard"
                  winPlatform.Size = Vector3.new(50, 2, 50)
                  winPlatform.Anchored = true
                  winPlatform.Material = Enum.Material.Neon
                  winPlatform.Color = Color3.fromRGB(0, 255, 150)
                  winPlatform.Parent = workspace
              end
              winPlatform.CFrame = hrp.CFrame - Vector3.new(0, 3, 0)
          else
              if winPlatform then
                  winPlatform:Destroy()
                  winPlatform = nil
              end
          end
      end)
   end,
})

MainTab:CreateLabel("Script Managed by DAVI")
